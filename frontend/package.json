{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-query": "^5.51.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "he": "^1.2.0",
    "lucide-react": "^0.542.0",
    "next": "^15.5.28",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^4.3.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:staging": "next build && node scripts/copy-headers.js staging && node scripts/apply-csp-hashes.js && node scripts/write-edge-config.js",
    "build:production": "next build && node scripts/copy-headers.js production && node scripts/apply-csp-hashes.js && node scripts/write-edge-config.js",
    "check:env": "echo 'NEXT_PUBLIC_API_URL:' $NEXT_PUBLIC_API_URL",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "generate:api": "orval --config ./orval.config.js",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.28",
    "@tanstack/react-query-devtools": "^5.51.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@types/he": "^1.2.3",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "orval": "^8.46.0",
    "prettier": "^3.6.2",
    "svgo": "^4.0.0",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
