# Next.js ステージング環境設定

# 環境
NODE_ENV=production

# ========================
# API設定
# ========================
# 注意: /apiは含めない（コード内で自動的に追加される）
NEXT_PUBLIC_API_URL=https://myanimelogs-staging.fly.dev
NEXT_PUBLIC_FRONTEND_URL=https://stg.myanimelogs.com

# ========================
# Supabase Auth（ステージング）
# ========================
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
# Supabase Dashboard > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-staging-anon-key-here

# ========================
# 機能フラグ
# ========================
NEXT_PUBLIC_ENABLE_MSW=false
NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ========================
# 最適化設定
# ========================
NEXT_TELEMETRY_DISABLED=1
GENERATE_SOURCEMAP=false
