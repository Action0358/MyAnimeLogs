# ========================
# Next.js アプリケーション設定
# ========================

# 環境
NODE_ENV=development

# ========================
# ホットリロード最適化
# ========================
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000
FAST_REFRESH=true
WDS_SOCKET_PORT=0

# ========================
# API設定
# ========================
# パブリック環境変数（ブラウザで利用可能）
# 注意: /apiは含めない（コード内で自動的に追加される）
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# サーバーサイド専用環境変数
API_BASE_URL=http://backend:8080

# ========================
# Supabase Auth（ローカル）
# ========================
# 取得方法:
#   1. `supabase start`（または `make local-supabase-up`）を実行
#   2. `npx supabase status` の Publishable key（= `supabase status -o env` の ANON_KEY）をコピー
#   3. 下記 NEXT_PUBLIC_SUPABASE_ANON_KEY に貼り付け
# ルート Makefile の `make local-supabase-up` / `make sync-anon-key` を使えば自動反映されます。
# Project URL: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-key-from-supabase-status

# ========================
# 機能フラグ
# ========================
NEXT_PUBLIC_ENABLE_MSW=false
NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ========================
# 認証設定
# ========================
# 非アクティブタイムアウト（秒）デフォルト: 1800秒（30分）
NEXT_PUBLIC_INACTIVITY_TIMEOUT=1800

# ========================
# 開発最適化
# ========================
NEXT_TELEMETRY_DISABLED=1
GENERATE_SOURCEMAP=true
NEXT_TYPESCRIPT_IGNORE_BUILD_ERRORS=false
NEXT_ESLINT_IGNORE_BUILD_ERRORS=false
