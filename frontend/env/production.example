# Next.js 本番環境設定

# 環境
NODE_ENV=production

# ========================
# API設定
# ========================
# 注意: /apiは含めない（コード内で自動的に追加される）
NEXT_PUBLIC_API_URL=https://myanimelogs-production.fly.dev
NEXT_PUBLIC_FRONTEND_URL=https://myanimelogs.com

# ========================
# Supabase Auth（本番）
# ========================
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project-ref.supabase.co
# Supabase Dashboard > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-production-anon-key-here

# ========================
# 機能フラグ
# ========================
NEXT_PUBLIC_ENABLE_MSW=false
NEXT_PUBLIC_ENABLE_DEBUG=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ========================
# 最適化設定
# ========================
NEXT_TELEMETRY_DISABLED=1
GENERATE_SOURCEMAP=false
