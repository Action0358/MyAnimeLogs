# ========================
# アプリケーション設定
# ========================

# 環境
NODE_ENV=development

# ========================
# Next.js 開発サーバー設定
# ========================
PORT=3000
HOSTNAME=0.0.0.0

# ========================
# ホットリロード最適化
# ========================
# ファイル監視の最適化（Docker環境用）
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000
# Fast Refresh有効化
FAST_REFRESH=true
# WebSocket設定
WDS_SOCKET_PORT=0

# ========================
# API設定（Next.js用）
# ========================
# パブリック環境変数（ブラウザで利用可能）
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# サーバーサイド専用環境変数
API_BASE_URL=http://backend:8080/api

# ========================
# 機能フラグ
# ========================
NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ========================
# 開発最適化
# ========================
# ソースマップ生成
GENERATE_SOURCEMAP=true
# TypeScript型チェック
NEXT_TYPESCRIPT_IGNORE_BUILD_ERRORS=false
# ESLint
NEXT_ESLINT_IGNORE_BUILD_ERRORS=false