# Cloudflare Pages用セキュリティヘッダー設定
# 本番環境では静的エクスポートのため、Next.jsのheadersが機能しないため、
# ホスティングプラットフォーム側でセキュリティヘッダーを設定

/*
  # クリックジャッキング対策
  X-Frame-Options: DENY
  
  # MIME タイプスニッフィング対策
  X-Content-Type-Options: nosniff
  
  # リファラーポリシー
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Content Security Policy - XSS対策の主要な防御手段
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.myanimelist.net; font-src 'self'; connect-src 'self'; frame-ancestors 'none';
  
  # HTTPS強制（本番環境では推奨）
  # Strict-Transport-Security: max-age=31536000; includeSubDomains; preload