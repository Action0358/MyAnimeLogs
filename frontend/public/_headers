# Netlify用セキュリティヘッダー設定（全環境対応）
# ステージング環境と本番環境の両方のAPIドメインを許可

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # 複数環境対応: ステージング、本番、その他のAPIドメインを許可
  # セキュリティを保ちつつ、柔軟性を確保
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.myanimelist.net; font-src 'self'; connect-src 'self' https://myanimelogs-staging.fly.dev https://myanimelogs-production.fly.dev https://*.myanimelogs.com https://api.myanimelogs.com; frame-ancestors 'none';