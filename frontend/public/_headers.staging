# Netlify用セキュリティヘッダー設定（ステージング環境）
# ステージング環境用のCSP設定

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # ステージング環境のAPIドメインを設定
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.myanimelist.net; font-src 'self'; connect-src 'self' https://myanimelogs-staging.fly.dev; frame-ancestors 'none';