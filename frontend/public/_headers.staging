# Netlify/Cloudflare Pages用セキュリティヘッダー設定（ステージング環境）
# 厳格なCSP設定で画像ソースを制限

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # ステージング環境のAPIドメインを設定
  # Cloudflare Access対応: script-srcに特定のハッシュを追加
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'sha256-Q+8tPsjVtiDsjF/Cv8FMOpg2Yg91oKFKDAJat1PPb2g=' 'sha256-6FQpZHRcM4a9kUiXv2qPLKuN9KSxTxfkgM3rXVFu1vo=' 'sha256-nnFddw7m5VtvxW5ATc11ubPHi8d1AgoZknPqhDlzKbA=' 'sha256-PIrRgVYW0YT3iDeJyB7dBxZesObDeMj/lY/rJeA4qgA=' 'sha256-Ig/65v8MeMS1kinDLLM52qw30SrxR4zElVqvCrZ5+H4='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.anilist.co https://cdn.myanimelist.net https://*.twimg.com https://i.imgur.com https://imgur.com https://avatars.githubusercontent.com https://github.com https://raw.githubusercontent.com https://*.gravatar.com https://*.cloudinary.com https://myanimelogs-staging.fly.dev; font-src 'self'; connect-src 'self' https://myanimelogs-staging.fly.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self';