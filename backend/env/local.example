# PostgreSQL
POSTGRES_DB=myanimelogs
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Application
PORT=8080
GIN_MODE=debug
ENVIRONMENT=development
RATE_LIMIT=100

# JWT Secret - WARNING: Change this in production!
JWT_SECRET=super-secret-key-change-me

# Annict API
ANNICT_API_KEY=your-annict-api-key-here

# Cache
REDIS_URL=redis://localhost:6379