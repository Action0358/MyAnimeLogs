# PostgreSQL（ローカルSupabase）
# `supabase start` で起動後に使用
# Dockerコンテナ内: host.docker.internal:54322、直接実行: localhost:54322
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=54322
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres?sslmode=disable

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Application
PORT=8080
GIN_MODE=debug
ENVIRONMENT=development
RATE_LIMIT=100

# ========================
# Supabase Auth（ローカル固定値）
# ========================
# `supabase start` のデフォルトJWTシークレット（変更不要）
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# DockerコンテナからSupabase APIにアクセスするURL
# Docker使用時: http://host.docker.internal:54321
# 直接実行時: http://localhost:54321
SUPABASE_URL=http://host.docker.internal:54321

# Annict API
ANNICT_API_KEY=your-annict-api-key-here

# Cache
REDIS_URL=redis://localhost:6379
