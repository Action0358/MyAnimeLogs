# データベース設定
DATABASE_URL=postgresql://postgres:password@localhost:5432/myanimelogs

# JWT設定
JWT_SECRET=your-256-bit-secret-key-here-make-it-long-and-random
JWT_EXPIRATION=24h

# 外部API
ANNICT_API_KEY=your-annict-api-key

# キャッシュ設定（オプション）
REDIS_URL=redis://localhost:6379

# サーバー設定
PORT=8080
ENVIRONMENT=development
RATE_LIMIT=5

# pgAdmin設定（Docker Compose用）
PGADMIN_DEFAULT_EMAIL=admin@myanimelogs.com
PGADMIN_DEFAULT_PASSWORD=admin123

# PostgreSQL設定（Docker Compose用）
POSTGRES_DB=myanimelogs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password