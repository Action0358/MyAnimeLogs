# Production Environment Configuration

# PostgreSQL (Production Database)
# NOTE: These should be overridden by actual production environment variables
POSTGRES_DB=myanimelogs_prod
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application
PORT=8080
GIN_MODE=release
ENVIRONMENT=production
RATE_LIMIT=60

# JWT Secret (MUST be changed in production)
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_256_BIT_SECRET

# Database Connection Pool (Production - Optimized for high load)
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=10
DB_CONN_MAX_IDLE_TIME=2

# External APIs
ANNICT_API_KEY=your-production-annict-api-key-here
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=info

# Security
CORS_ALLOWED_ORIGINS=https://myanimelogs.com,https://www.myanimelogs.com
HTTPS_ONLY=true
