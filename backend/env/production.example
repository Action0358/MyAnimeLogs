# Production Environment Configuration

# PostgreSQL (Production - Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Application
PORT=8080
GIN_MODE=release
ENVIRONMENT=production
RATE_LIMIT=60

# ========================
# Supabase Auth（本番）
# ========================
# Supabase Dashboard > Project Settings > API > JWT Settings > JWT Secret
# 本番では fly secrets set SUPABASE_JWT_SECRET=xxx で設定（.envファイルに書かない）
SUPABASE_JWT_SECRET=CHANGE_ME_SET_AS_FLY_SECRET

# Database Connection Pool (Production)
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=10
DB_CONN_MAX_IDLE_TIME=2

# External APIs
ANNICT_API_KEY=your-production-annict-api-key-here
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=info
