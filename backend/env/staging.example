# Staging Environment Configuration

# PostgreSQL (Staging Database)
POSTGRES_DB=myanimelogs_staging
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=staging_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application
PORT=8081
GIN_MODE=test
ENVIRONMENT=staging
RATE_LIMIT=1000

# JWT Secret (Staging)
JWT_SECRET=staging-jwt-secret-key

# Database Connection Pool (Staging)
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=2
DB_CONN_MAX_IDLE_TIME=1

# External APIs (Staging Environment)
ANNICT_API_KEY=your-staging-annict-api-key-here
REDIS_URL=redis://localhost:6379/1

# Logging
LOG_LEVEL=debug

# Security (Staging Environment)
CORS_ALLOWED_ORIGINS=https://stg.myanimelogs.com,http://localhost:3000,http://localhost:3001
HTTPS_ONLY=false
