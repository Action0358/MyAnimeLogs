# Staging Environment Configuration

# PostgreSQL (Staging - Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Application
PORT=8080
GIN_MODE=release
ENVIRONMENT=staging
# 1つのIPアドレスから1分間に受け付けるリクエスト数
RATE_LIMIT_PER_MINUTE=6000

# ========================
# Supabase Auth（ステージング）
# ========================
# Supabase Dashboard > Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=your-supabase-staging-jwt-secret-here

# Database Connection Pool (Staging)
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=2
DB_CONN_MAX_IDLE_TIME=1

# External APIs
ANNICT_API_KEY=your-staging-annict-api-key-here
# あらすじの日本語翻訳・整形（未設定時は翻訳をスキップ）。Fly.ioシークレットで設定: fly secrets set ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=your-staging-anthropic-api-key-here
REDIS_URL=redis://localhost:6379/1

# Logging
LOG_LEVEL=debug
