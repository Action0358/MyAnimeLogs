# backend/.env.test.example
# バックエンド用の.env.test.example

# データベース接続設定 (テスト環境用)
POSTGRES_HOST=postgres_test # テスト用DBホスト
POSTGRES_PORT=5432
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_NAME=myanimelogs_test # テスト用DB名

# JWTシークレット (テスト環境用)
JWT_SECRET=test_jwt_secret

# CORS設定 (テスト環境用)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# その他のテスト固有の環境変数
LOG_LEVEL=debug
