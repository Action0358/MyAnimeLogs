# --- ビルダーステージ ---
# Go はパッチ版まで固定する。golang:1.26-alpine のような可変タグだと、ビルドした
# 時点の版に左右され、標準ライブラリの脆弱性修正が入ったか分からなくなるため。
# 更新するときは Dockerfile（開発用）と揃えること。
FROM golang:1.26.10-alpine3.24 AS builder
WORKDIR /app

# 必要なパッケージのみインストール（アップデートをスキップして安定性を優先）
RUN apk add --no-cache git

# モジュールファイルをコピーし、依存関係をダウンロード
COPY go.mod go.sum ./
RUN go mod download

# バックエンドの残りのソースコードをコピー
COPY . .

# アプリケーションを静的バイナリとしてビルド
# バイナリサイズを削減するために-ldflagsを使用
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/main ./cmd/server

# マイグレーションスクリプトも静的バイナリとしてビルド
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/migrate ./scripts/migrate.go

# --- Final Stage ---
# サポート期間内の Alpine を使う（3.24 のサポート終了は 2028-06）。
# 終了した版では OS パッケージ（CA証明書など）の修正が届かない。
FROM alpine:3.24

# 必要なパッケージのみインストール（安定版のAlpineを使用）
# postgresql-client: マイグレーション実行用
# bash: シェルスクリプト実行用
RUN apk add --no-cache ca-certificates tzdata curl postgresql-client bash

# 非rootユーザーとグループを作成
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# 作業ディレクトリを設定
WORKDIR /app

# ビルダー段階からコンパイル済みバイナリをコピーし、所有者を設定
COPY --from=builder --chown=appuser:appgroup /app/main /app/main
COPY --from=builder --chown=appuser:appgroup /app/migrate /app/migrate

# マイグレーションファイルとスクリプトをコピー
COPY --from=builder --chown=appuser:appgroup /app/migrations /app/migrations
COPY --from=builder --chown=appuser:appgroup /app/scripts/migrate.sh /app/migrate.sh

# バイナリとスクリプトに実行権限を付与
RUN chmod +x /app/main /app/migrate /app/migrate.sh

# エントリーポイントスクリプトを作成
RUN echo '#!/bin/sh' > /app/entrypoint.sh && \
    echo 'set -e' >> /app/entrypoint.sh && \
    echo '' >> /app/entrypoint.sh && \
    echo '# ボリュームマウントされたディレクトリの権限を設定' >> /app/entrypoint.sh && \
    echo 'if [ -d /app/uploads ]; then' >> /app/entrypoint.sh && \
    echo '  echo "Setting permissions for /app/uploads..."' >> /app/entrypoint.sh && \
    echo '  chown -R appuser:appgroup /app/uploads || true' >> /app/entrypoint.sh && \
    echo 'fi' >> /app/entrypoint.sh && \
    echo '' >> /app/entrypoint.sh && \
    echo '# appuserとして実行' >> /app/entrypoint.sh && \
    echo 'exec su-exec appuser "$@"' >> /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh

# su-execをインストール（軽量なgosuの代替）
RUN apk add --no-cache su-exec

# アプリが実行されるポートを公開
EXPOSE 8080

# ヘルスチェック用のエンドポイントを確認
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# エントリーポイントを設定（rootとして実行）
ENTRYPOINT ["/app/entrypoint.sh"]

# デフォルトコマンド
CMD ["/app/main"]