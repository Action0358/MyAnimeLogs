# --- ビルダーステージ ---
FROM golang:1.22-alpine AS builder
WORKDIR /app

# モジュールファイルをコピーし、依存関係をダウンロード
COPY go.mod go.sum ./
RUN go mod download

# バックエンドの残りのソースコードをコピー
COPY . .

# アプリケーションを静的バイナリとしてビルド
# バイナリサイズを削減するために-ldflagsを使用
RUN CGO_ENABLED=0 go build -ldflags="-w -s" -o /app/main ./cmd/server

# --- Final Stage ---
FROM alpine:3.20

# 非rootユーザーとグループを作成
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# HTTPSリクエスト用にca-certificatesをインストール
RUN apk --no-cache add ca-certificates

# 作業ディレクトリを設定
WORKDIR /app

# ビルダー段階からコンパイル済みバイナリをコピーし、所有者を設定
COPY --from=builder --chown=appuser:appgroup /app/main /app/main

# アプリが実行されるポートを公開
EXPOSE 8080

# 非rootユーザーに切り替え
USER appuser

# バイナリをエントリポイントとして設定
CMD ["/app/main"]