# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/myanimelogs

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-here-make-it-long-and-random
JWT_EXPIRATION=24h

# External API
ANNICT_API_KEY=your-annict-api-key

# Cache Configuration (Optional)
REDIS_URL=redis://localhost:6379

# Server Configuration
PORT=8080
ENVIRONMENT=development
RATE_LIMIT=5

# pgAdmin Configuration (for Docker Compose)
PGADMIN_DEFAULT_EMAIL=admin@myanimelogs.com
PGADMIN_DEFAULT_PASSWORD=admin123

# PostgreSQL Configuration (for Docker Compose)
POSTGRES_DB=myanimelogs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password